# URL da API (bilheteria-api). Variáveis EXPO_PUBLIC_* vão para o código do app: nunca coloque segredos aqui.
#  - Web e emulador iOS no mesmo computador: http://localhost:3333
#  - Celular com Expo Go: use o IP do computador na rede local, ex.: http://192.168.0.10:3333
#    (e inclua a origem do app no CORS_ORIGIN do backend, se for web)
#  - Emulador Android: http://10.0.2.2:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
