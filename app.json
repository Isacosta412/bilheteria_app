{
  "expo": {
    "name": "Pipocou",
    "slug": "pipocou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pipocou",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14110F",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14110F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Pipocou",
      "lang": "pt-BR",
      "description": "Teu lugar, tua pipoca, tua sessão.",
      "themeColor": "#14110F",
      "backgroundColor": "#14110F",
      "shortName": "Pipocou"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para ler o QR code dos ingressos na entrada da sala.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14110F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
